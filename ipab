#!/usr/bin/env bash
# ipab — собирает .ipa из исходников C / C++ / Objective-C / Objective-C++ / Swift на Linux.
#
#   ipab new <папка> [objc|swift|swiftui|c]   создать проект из шаблона
#   ipab build [папка] [--release]            собрать (по умолчанию — текущая папка)
#   ipab clean [папка]                        удалить build/
#
# Сборка инкрементальная: пересобираются только изменённые файлы (через make -j).
set -euo pipefail

IPAB_HOME=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
TC=$IPAB_HOME/toolchains
SDK=${IPAB_SDK:-$(ls -d "$IPAB_HOME"/sdks/iPhoneOS*.sdk 2>/dev/null | sort -V | tail -1)}
SWIFTC=$TC/swift/usr/bin/swiftc
LDID=$TC/bin/ldid
CACHE=$IPAB_HOME/cache
JOBS=${IPAB_JOBS:-$(nproc)}

die() { printf '\033[31mошибка:\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[36m==>\033[0m %s\n' "$*"; }

# ---------------------------------------------------------------- new
cmd_new() {
	local dir=${1:?укажи папку}; local kind=${2:-objc}
	[ -e "$dir" ] && die "$dir уже существует"
	local name; name=$(basename "$dir")
	mkdir -p "$dir/src"  # res/ создаётся при необходимости: ipab без неё обходится
	cat > "$dir/ipa.conf" <<EOF
# Конфиг проекта. Это bash — можно использовать переменные.
NAME="$name"
BUNDLE_ID="com.example.$(printf '%s' "$name" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')"
VERSION="1.0"
BUILD="1"
MIN_IOS="15.0"
FRAMEWORKS="Foundation UIKit"   # -framework X
LIBS=""                         # -lX
CFLAGS=""                       # для C/C++/ObjC
SWIFTFLAGS=""
LDFLAGS=""
BRIDGING_HEADER=""              # напр. src/Bridging.h — ObjC/C из Swift
ICON=""                         # напр. res/icon.png (квадрат 1024x1024)
ENTITLEMENTS=""                 # напр. app.entitlements
EOF
	case $kind in
	objc) cat > "$dir/src/main.m" <<'EOF'
#import <UIKit/UIKit.h>

@interface AppDelegate : UIResponder <UIApplicationDelegate>
@property (nonatomic, strong) UIWindow *window;
@end

@implementation AppDelegate
- (BOOL)application:(UIApplication *)app didFinishLaunchingWithOptions:(NSDictionary *)opts {
	self.window = [[UIWindow alloc] initWithFrame:UIScreen.mainScreen.bounds];
	UIViewController *vc = [UIViewController new];
	vc.view.backgroundColor = UIColor.systemBackgroundColor;
	UILabel *l = [[UILabel alloc] initWithFrame:vc.view.bounds];
	l.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
	l.textAlignment = NSTextAlignmentCenter;
	l.text = @"Привет из ipab (ObjC)";
	[vc.view addSubview:l];
	self.window.rootViewController = vc;
	[self.window makeKeyAndVisible];
	return YES;
}
@end

int main(int argc, char *argv[]) {
	@autoreleasepool {
		return UIApplicationMain(argc, argv, nil, NSStringFromClass(AppDelegate.class));
	}
}
EOF
	;;
	swift) cat > "$dir/src/App.swift" <<'EOF'
import UIKit

@main
class AppDelegate: UIResponder, UIApplicationDelegate {
	var window: UIWindow?

	func application(_ app: UIApplication, didFinishLaunchingWithOptions opts: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
		let vc = UIViewController()
		vc.view.backgroundColor = .systemBackground
		let l = UILabel(frame: vc.view.bounds)
		l.autoresizingMask = [.flexibleWidth, .flexibleHeight]
		l.textAlignment = .center
		l.text = "Привет из ipab (Swift)"
		vc.view.addSubview(l)
		let w = UIWindow(frame: UIScreen.main.bounds)
		w.rootViewController = vc
		w.makeKeyAndVisible()
		window = w
		return true
	}
}
EOF
	;;
	swiftui) sed -i 's/^FRAMEWORKS=.*/FRAMEWORKS="Foundation UIKit SwiftUI"/' "$dir/ipa.conf"
	cat > "$dir/src/App.swift" <<'EOF'
import SwiftUI

@main
struct MyApp: App {
	@State private var n = 0
	var body: some Scene {
		WindowGroup {
			VStack(spacing: 16) {
				Text("Привет из ipab (SwiftUI)")
				Button("Нажато: \(n)") { n += 1 }
			}
		}
	}
}
EOF
	;;
	c) cat > "$dir/src/main.c" <<'EOF'
// Чистый C: UIKit через objc runtime.
#include <objc/runtime.h>
#include <objc/message.h>
#include <CoreFoundation/CoreFoundation.h>

extern int UIApplicationMain(int, char **, void *, CFStringRef);

#define MSG(ret, ...) ((ret (*)(id, SEL, ##__VA_ARGS__))objc_msgSend)
#define CLS(n) ((id)objc_getClass(n))
#define SEL_(n) sel_registerName(n)

static BOOL did_finish(id self, SEL _cmd, id app, id opts) {
	id screen = MSG(id)(CLS("UIScreen"), SEL_("mainScreen"));
	CGRect b = MSG(CGRect)(screen, SEL_("bounds"));
	id win = MSG(id, CGRect)(MSG(id)(CLS("UIWindow"), SEL_("alloc")), SEL_("initWithFrame:"), b);
	id vc = MSG(id)(MSG(id)(CLS("UIViewController"), SEL_("alloc")), SEL_("init"));
	id view = MSG(id)(vc, SEL_("view"));
	MSG(void, id)(view, SEL_("setBackgroundColor:"), MSG(id)(CLS("UIColor"), SEL_("systemIndigoColor")));
	MSG(void, id)(win, SEL_("setRootViewController:"), vc);
	MSG(void)(win, SEL_("makeKeyAndVisible"));
	object_setInstanceVariable(self, "window", win);
	return YES;
}

int main(int argc, char *argv[]) {
	Class c = objc_allocateClassPair(objc_getClass("UIResponder"), "AppDelegate", 0);
	class_addIvar(c, "window", sizeof(id), 3, "@");
	class_addMethod(c, SEL_("application:didFinishLaunchingWithOptions:"), (IMP)did_finish, "B@:@@");
	objc_registerClassPair(c);
	return UIApplicationMain(argc, argv, NULL, CFSTR("AppDelegate"));
}
EOF
	;;
	*) rm -rf "$dir"; die "неизвестный шаблон: $kind (objc|swift|swiftui|c)" ;;
	esac
	say "создан $dir ($kind). Сборка: ipab build $dir"
}

# ---------------------------------------------------------------- build
plist_escape() { local s=$1; s=${s//&/&amp;}; s=${s//</&lt;}; s=${s//>/&gt;}; printf '%s' "$s"; }

write_info_plist() {
	local out=$1 sdkver; sdkver=$(basename "$SDK" .sdk); sdkver=${sdkver#iPhoneOS}
	if [ -f "$PROJ/Info.plist" ]; then cp "$PROJ/Info.plist" "$out"; return; fi
	local icon=""
	[ -n "$ICON" ] && icon="	<key>CFBundleIcons</key>
	<dict><key>CFBundlePrimaryIcon</key><dict>
		<key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array>
		<key>CFBundleIconName</key><string>AppIcon</string>
	</dict></dict>
	<key>CFBundleIcons~ipad</key>
	<dict><key>CFBundlePrimaryIcon</key><dict>
		<key>CFBundleIconFiles</key><array><string>AppIcon60x60</string><string>AppIcon76x76</string></array>
		<key>CFBundleIconName</key><string>AppIcon</string>
	</dict></dict>"
	local extra=""
	[ -f "$PROJ/Info.extra.plist" ] && extra=$(cat "$PROJ/Info.extra.plist")
	cat > "$out" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>$(plist_escape "$NAME")</string>
	<key>CFBundleIdentifier</key><string>$(plist_escape "$BUNDLE_ID")</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(plist_escape "$NAME")</string>
	<key>CFBundleDisplayName</key><string>$(plist_escape "${DISPLAY_NAME:-$NAME}")</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(plist_escape "$VERSION")</string>
	<key>CFBundleVersion</key><string>$(plist_escape "$BUILD")</string>
	<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
	<key>DTPlatformName</key><string>iphoneos</string>
	<key>DTSDKName</key><string>iphoneos$sdkver</string>
	<key>DTPlatformVersion</key><string>$sdkver</string>
	<key>MinimumOSVersion</key><string>$MIN_IOS</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
	<key>UILaunchScreen</key><dict/>
	<key>UIApplicationSupportsIndirectInputEvents</key><true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
$icon
$extra
</dict>
</plist>
EOF
}

cmd_build() {
	local release=0 arg; PROJ=.
	for arg; do case $arg in --release|-r) release=1 ;; *) PROJ=$arg ;; esac; done
	PROJ=$(cd "$PROJ" && pwd)
	[ -f "$PROJ/ipa.conf" ] || die "нет $PROJ/ipa.conf (создай проект: ipab new <папка>)"
	[ -d "$SDK" ] || die "не найден iOS SDK в $IPAB_HOME/sdks"

	NAME="" BUNDLE_ID="" VERSION=1.0 BUILD=1 MIN_IOS=15.0 FRAMEWORKS="Foundation UIKit" LIBS=""
	CFLAGS="" SWIFTFLAGS="" LDFLAGS="" BRIDGING_HEADER="" ICON="" ENTITLEMENTS="" DISPLAY_NAME="" RELEASES="" EXTRA_RES=""
	MANIFEST="" ROOTS="" SRCROOT="" EXTDIR="" PREBUILD="" SWIFT_THREADS=4 GENRULES="" GENRULE_OVERRIDES="" GENRULE_SED="" RESOURCES=""
	# shellcheck disable=SC1091
	. "$PROJ/ipa.conf"
	[ -n "$NAME" ] || die "NAME пустой в ipa.conf"
	[ -n "$BUNDLE_ID" ] || die "BUNDLE_ID пустой в ipa.conf"
	# release: следующая версия (последнее число +1) и номер сборки; в ipa.conf пишем только после успешной сборки
	if [ $release = 1 ]; then
		# IPAB_VERSION=1.0 — задать версию явно (например, переход 0.9.x → 1.0), иначе последнее число +1
		if [ -n "${IPAB_VERSION:-}" ]; then VERSION=$IPAB_VERSION
		elif [[ $VERSION =~ ^(.*[^0-9])?([0-9]+)$ ]]; then VERSION="${BASH_REMATCH[1]}$((10#${BASH_REMATCH[2]} + 1))"; fi
		[[ $BUILD =~ ^[0-9]+$ ]] && BUILD=$((BUILD + 1))
	fi

	local B=$PROJ/build mode=debug; [ $release = 1 ] && mode=release
	local OBJ=$B/obj/$mode APP=$B/Payload/$NAME.app
	local MOD; MOD=$(printf '%s' "$NAME" | tr -c '[:alnum:]_\n' '_'); [[ $MOD =~ ^[0-9] ]] && MOD=_$MOD
	mkdir -p "$OBJ" "$APP" "$CACHE"

	if [ -n "$MANIFEST" ]; then
	build_manifest
	else
	# --- исходники
	local -a cfam=() swift=()
	local f
	while IFS= read -r -d '' f; do
		case $f in
		*.c|*.m|*.mm|*.cpp|*.cc|*.cxx) cfam+=("${f#"$PROJ"/}") ;;
		*.swift) swift+=("${f#"$PROJ"/}") ;;
		esac
	done < <(find "$PROJ/src" -type f \( -name '*.c' -o -name '*.m' -o -name '*.mm' -o -name '*.cpp' \
		-o -name '*.cc' -o -name '*.cxx' -o -name '*.swift' \) -print0 2>/dev/null | sort -z)
	[ ${#cfam[@]} -gt 0 ] || [ ${#swift[@]} -gt 0 ] || die "в $PROJ/src нет исходников"

	local has_cxx=0 has_objc=0
	for f in "${cfam[@]}"; do case $f in *.mm|*.cpp|*.cc|*.cxx) has_cxx=1 ;; esac; case $f in *.m|*.mm) has_objc=1 ;; esac; done
	[ ${#swift[@]} -gt 0 ] && [ ! -x "$SWIFTC" ] && die "есть .swift, но нет тулчейна Swift в $TC/swift"

	local TGT="-target arm64-apple-ios$MIN_IOS -isysroot $SDK"
	local OPTC="-O0" OPTS="-Onone -incremental -enable-batch-mode -j$JOBS" LDX=""
	if [ $release = 1 ]; then OPTC="-Os"; OPTS="-O -wmo -num-threads $JOBS"; LDX="-Wl,-dead_strip -Wl,-x"; fi
	local INC="-I$PROJ/src -I$B/gen"
	local fw="" x; for x in $FRAMEWORKS; do fw+=" -framework $x"; done
	for x in $LIBS; do fw+=" -l$x"; done

	# --- stamp-файлы флагов: сменил флаги в ipa.conf — пересоберётся только то, что они затрагивают
	stamp() { printf '%s\n' "$2" > "$OBJ/$1.tmp"; cmp -s "$OBJ/$1.tmp" "$OBJ/$1" && rm "$OBJ/$1.tmp" || mv "$OBJ/$1.tmp" "$OBJ/$1"; }
	stamp cflags.stamp "$SDK $TGT $OPTC $INC $CFLAGS"
	stamp swflags.stamp "$SDK $MIN_IOS $OPTS $SWIFTFLAGS $BRIDGING_HEADER"
	stamp ldflags.stamp "$SDK $TGT $LDX $FRAMEWORKS $LIBS $LDFLAGS $ENTITLEMENTS"

	# рантайм-заглушка (__isPlatformVersionAtLeast), собирается один раз на SDK
	local RT; RT=$CACHE/rt/availability-$(basename "$SDK" .sdk).o

	# --- Makefile
	local MK=$B/Makefile.$mode objs="" swobjs="" swstamp=""
	{
		echo "CC := clang"
		echo "CXX := clang++"
		echo "BASE := $TGT $OPTC -fmodules -fmodules-cache-path=$CACHE/clang $INC -MMD -MP $CFLAGS"
		echo ".SUFFIXES:"
		echo "all: $OBJ/$NAME"
		if [ ${#swift[@]} -gt 0 ]; then
			swstamp=$OBJ/swift.stamp
			local map=$OBJ/swift-map.json parse="-parse-as-library" s
			for s in "${swift[@]}"; do [ "$(basename "$s")" = main.swift ] && parse=""; done
			{
				printf '{"":{"swift-dependencies":"%s/master.swiftdeps"}' "$OBJ"
				for s in "${swift[@]}"; do
					printf ',\n"%s":{"object":"%s/%s.o","swift-dependencies":"%s/%s.swiftdeps"}' \
						"$PROJ/$s" "$OBJ" "$s" "$OBJ" "$s"
					swobjs+=" $OBJ/$s.o"
				done
				echo "}"
			} > "$map.tmp"
			cmp -s "$map.tmp" "$map" && rm "$map.tmp" || mv "$map.tmp" "$map"
			for s in "${swift[@]}"; do mkdir -p "$OBJ/$(dirname "$s")"; done
			local bh="" hdr=""
			[ -n "$BRIDGING_HEADER" ] && bh="-import-objc-header $PROJ/$BRIDGING_HEADER"
			[ $has_objc = 1 ] && hdr="-emit-objc-header-path $B/gen/$MOD-Swift.h"
			local swsrc=""; for s in "${swift[@]}"; do swsrc+=" $PROJ/$s"; done
			echo "$swstamp:$swsrc $map $OBJ/swflags.stamp ${BRIDGING_HEADER:+$PROJ/$BRIDGING_HEADER}"
			printf '\t@echo "  SWIFT  (%s файлов)"\n' "${#swift[@]}"
			printf '\t@mkdir -p %s\n' "$B/gen"
			printf '\t@%s -c %s -module-name %s %s -sdk %s -target arm64-apple-ios%s -resource-dir %s -module-cache-path %s -runtime-compatibility-version none -output-file-map %s %s %s %s -I%s/src %s\n' \
				"$SWIFTC" "$swsrc" "$MOD" "$OPTS" "$SDK" "$MIN_IOS" "$TC/darwin-res" "$CACHE/swift" "$map" "$parse" "$bh" "$hdr" "$PROJ" "$SWIFTFLAGS"
			printf '\t@touch $@\n'
		fi
		for f in "${cfam[@]}"; do
			local o=$OBJ/$f.o cc='$(CC)' lang=""
			case $f in
			*.c) lang="-std=gnu17" ;;
			*.m) lang="-fobjc-arc" ;;
			*.mm) cc='$(CXX)'; lang="-fobjc-arc -std=gnu++20" ;;
			*) cc='$(CXX)'; lang="-std=gnu++20" ;;
			esac
			# ObjC-файлы в смешанном проекте ждут сгенерированный <Модуль>-Swift.h
			local dep=""; case $f in *.m|*.mm) [ -n "$swstamp" ] && dep=" | $swstamp" ;; esac
			echo "$o: $PROJ/$f $OBJ/cflags.stamp$dep"
			printf '\t@echo "  CC     %s"\n' "$f"
			printf '\t@mkdir -p %s\n' "$(dirname "$o")"
			printf '\t@%s $(BASE) %s -c %s -o $@\n' "$cc" "$lang" "$PROJ/$f"
			echo "-include $OBJ/$f.d"
			objs+=" $o"
		done
		local linker='$(CC)'; [ $has_cxx = 1 ] && linker='$(CXX)'
		local swl=""; [ ${#swift[@]} -gt 0 ] && swl="-L$SDK/usr/lib/swift -Wl,-rpath,/usr/lib/swift"
		local ent=""; [ -n "$ENTITLEMENTS" ] && ent=$PROJ/$ENTITLEMENTS
		echo "$RT: $IPAB_HOME/runtime/availability.c"
		printf '\t@mkdir -p %s\n' "$CACHE/rt"
		printf '\t@clang -target arm64-apple-ios12.0 -isysroot %s -O2 -c $< -o $@\n' "$SDK"
		echo "$OBJ/$NAME:$objs $swstamp $RT $OBJ/ldflags.stamp $ent"
		printf '\t@echo "  LD     %s"\n' "$NAME"
		printf '\t@%s %s -fuse-ld=lld %s %s %s %s -Wl,-rpath,@executable_path/Frameworks %s %s %s -o $@\n' \
			"$linker" "$TGT" "$LDX" "$objs" "$swobjs" "$RT" "$swl" "$fw" "$LDFLAGS"
		[ -x "$LDID" ] && printf '\t@%s -S%s $@\n' "$LDID" "$ent"
	} > "$MK.tmp"
	cmp -s "$MK.tmp" "$MK" && rm "$MK.tmp" || mv "$MK.tmp" "$MK"

	say "сборка $NAME ($mode, $JOBS потоков)"
	make -s -f "$MK" -j"$JOBS" || die "компиляция не удалась"
	fi
	if [ -n "$MANIFEST" ] && [ -n "$RESOURCES" ]; then
		process_resources "$(cd "$PROJ/${SRCROOT:-.}" && pwd)" "$(cd "$PROJ" && readlink -f "${EXTDIR:-external}")" "$B/gen" "$APP"
	fi

	# --- бандл (копируем только изменившееся, чтобы zip не перепаковывал лишнее)
	cmp -s "$OBJ/$NAME" "$APP/$NAME" || cp "$OBJ/$NAME" "$APP/$NAME"
	write_info_plist "$B/Info.plist.tmp"
	cmp -s "$B/Info.plist.tmp" "$APP/Info.plist" && rm "$B/Info.plist.tmp" || mv "$B/Info.plist.tmp" "$APP/Info.plist"
	[ -f "$APP/PkgInfo" ] || printf 'APPL????' > "$APP/PkgInfo"
	if [ -d "$PROJ/res" ] && [ -n "$(ls -A "$PROJ/res")" ]; then cp -a -u "$PROJ/res/." "$APP/"; fi
	# EXTRA_RES: ещё папки/файлы проекта, кладутся в корень .app под своим именем
	for x in $EXTRA_RES; do
		[ -e "$PROJ/$x" ] || die "нет $x (EXTRA_RES)"
		cp -a -u "$PROJ/$x" "$APP/"
	done
	if [ -n "$ICON" ]; then
		[ -f "$PROJ/$ICON" ] || die "нет иконки $ICON"
		for x in AppIcon60x60@2x AppIcon60x60@3x AppIcon76x76@2x; do cp -u "$PROJ/$ICON" "$APP/$x.png"; done
	fi
	# --- .ipa
	local IPA=$B/$NAME.ipa
	(cd "$B" && zip -q -r -FS -1 -X "$IPA" Payload) || die "zip не удался"
	say "готово: $IPA ($(du -h "$IPA" | cut -f1))"
	# release: записываем новую версию в ipa.conf, в releases/ остаётся только свежий <имя>-<версия>.ipa
	if [ $release = 1 ]; then
		sed -i "s/^VERSION=\"[^\"]*\"/VERSION=\"$VERSION\"/; s/^BUILD=\"[^\"]*\"/BUILD=\"$BUILD\"/" "$PROJ/ipa.conf"
		local REL=${RELEASES:-$IPAB_HOME/releases}
		mkdir -p "$REL"
		rm -f "$REL/$NAME-"[0-9]*.ipa "$REL/$NAME-"[0-9]*.map "$REL/$NAME-latest.ipa"
		cp "$IPA" "$REL/$NAME-$VERSION.ipa"
		# карта символов (если проект пишет её через LDFLAGS=-Wl,-map,…) — для расшифровки отчётов о вылетах
		[ -f "$B/$NAME.map" ] && cp "$B/$NAME.map" "$REL/$NAME-$VERSION.map"
		say "релиз $VERSION (сборка $BUILD): $REL/$NAME-$VERSION.ipa"
	fi
}

# ---------------------------------------------------------------- genrules
# GENRULES=genrules.tsv: label, inputs, outputs, base64 bash command (placeholders @@SRC@@ @@EXT@@ @@GEN@@).
# Rules run in dependency order from $SRC (like Bazel's execroot); a rule is skipped while its
# command is unchanged, all outputs exist and no input is newer than its stamp.
run_genrules() {
	local SRC=$1 EXT=$2 GEN=$3 XPATH=$4 MK=$5
	local file=$PROJ/$GENRULES dir=$GEN/.genrules LIBS=$OBJ/libs
	[ -f "$file" ] || die "нет $file"
	# Like Bazel, commands get paths relative to $SRC (scripts do "$(pwd)/$(RULEDIR)").
	local RGEN=$GEN REXT=$EXT
	case $GEN in "$SRC"/*) RGEN=${GEN#"$SRC"/} ;; esac
	case $EXT in "$SRC"/*) REXT=${EXT#"$SRC"/} ;; esac
	mkdir -p "$dir"
	local -a labels=() ins=() outs=() cmds=()
	local -A producer=()
	local label in out cmd i=0 o
	while IFS=$'\t' read -r label in out cmd; do
		in=${in//@@SRC@@/$SRC}; in=${in//@@EXT@@/$EXT}; in=${in//@@GEN@@/$GEN}; in=${in//@@LIB@@/$LIBS}
		out=${out//@@GEN@@/$GEN}
		labels+=("$label"); ins+=("$in"); outs+=("$out"); cmds+=("$cmd")
		for o in $out; do producer[$o]=$i; done
		i=$((i + 1))
	done < "$file"
	local n=$i
	# topological order
	local -A done_=()
	local -a order=()
	local progress=1 j ok
	while [ ${#order[@]} -lt $n ] && [ $progress = 1 ]; do
		progress=0
		for ((i = 0; i < n; i++)); do
			[ -n "${done_[$i]:-}" ] && continue
			ok=1
			for o in ${ins[$i]}; do
				j=${producer[$o]:-}
				if [ -n "$j" ] && [ "$j" != "$i" ] && [ -z "${done_[$j]:-}" ]; then ok=0; break; fi
			done
			[ $ok = 1 ] && { order+=("$i"); done_[$i]=1; progress=1; }
		done
	done
	[ ${#order[@]} = $n ] || die "циклическая зависимость в $GENRULES"
	local id stamp hash log fresh
	for i in "${order[@]}"; do
		label=${labels[$i]}
		id=$(printf '%s' "$label" | tr -c '[:alnum:]_' '_')
		stamp=$dir/$id.stamp
		log=$dir/$id.log
		# GENRULE_OVERRIDES/<id>.sh replaces a command that cannot run on Linux (same placeholders)
		if [ -n "$GENRULE_OVERRIDES" ] && [ -f "$PROJ/$GENRULE_OVERRIDES/$id.sh" ]; then
			cmd=$(cat "$PROJ/$GENRULE_OVERRIDES/$id.sh")
		else
			cmd=$(printf '%s' "${cmds[$i]}" | base64 -d)
		fi
		# GENRULE_SED: sed script applied to every command (e.g. drop macOS-only tools from PATH)
		[ -n "$GENRULE_SED" ] && cmd=$(printf '%s\n' "$cmd" | sed -f "$PROJ/$GENRULE_SED")
		cmd=${cmd//@@SRC@@\//}; cmd=${cmd//@@EXT@@/$REXT}; cmd=${cmd//@@GEN@@/$RGEN}; cmd=${cmd//@@LIB@@/$LIBS}
		hash=$(printf '%s' "$cmd" | md5sum | cut -d' ' -f1)
		fresh=0
		if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$hash" ]; then
			fresh=1
			for o in ${outs[$i]}; do [ -e "$o" ] || { fresh=0; break; }; done
			if [ $fresh = 1 ]; then
				for o in ${ins[$i]}; do [ "$o" -nt "$stamp" ] && { fresh=0; break; }; done
			fi
		fi
		[ $fresh = 1 ] && continue
		# libraries the command uses ($(location <cc_library>)) are built first
		local -a needlibs=()
		for o in ${ins[$i]}; do case $o in "$LIBS"/*) needlibs+=("$o") ;; esac; done
		if [ ${#needlibs[@]} -gt 0 ]; then
			make -s -C "$SRC" -f "$MK" -j"$JOBS" "${needlibs[@]}" || die "не собрались библиотеки для $label"
		fi
		say "genrule $label"
		for o in ${outs[$i]}; do mkdir -p "$(dirname "$o")"; done
		rm -f "$stamp"
		if ! (cd "$SRC" && PATH=$XPATH IPAB_SDK=$SDK IPAB_MIN_IOS=$MIN_IOS bash -c "$cmd") > "$log" 2>&1; then
			tail -n 40 "$log" >&2
			die "genrule $label не удался (лог: $log)"
		fi
		for o in ${outs[$i]}; do [ -e "$o" ] || die "genrule $label не создал $o (лог: $log)"; done
		printf '%s' "$hash" > "$stamp"
	done
}

# Writes the MANIFEST-mode Makefile (uses build_manifest's locals: OBJ OPTC OPTS release …).
write_manifest_makefile() {
	local SRC=$1 EXT=$2 GEN=$3 MK=$4
	local RT; RT=$CACHE/rt/availability-$(basename "$SDK" .sdk).o
	local ent=""; [ -n "$ENTITLEMENTS" ] && ent=$PROJ/$ENTITLEMENTS
	{
		awk -v SRCROOT="$SRC" -v EXT="$EXT" -v GEN="$GEN" -v B="$OBJ" -v SWIFTC="$SWIFTC" -v TCRES="$TC/darwin-res" \
			-v SDK="$SDK" -v MINIOS="$MIN_IOS" -v CACHE="$CACHE" -v OPTC="$OPTC $CFLAGS" -v OPTS="$OPTS $SWIFTFLAGS" \
			-v SWIFT_THREADS="$SWIFT_THREADS" -v ROOTS="$ROOTS" -v OUT="$OBJ/$NAME" -v RTOBJ="$RT" \
			-v LDID="$([ -x "$LDID" ] && echo "$LDID")" -v ENT="$ent" -v LDFLAGS="$LDFLAGS" -v AR="$TC/llvm-native/bin/llvm-ar" \
			-f "$IPAB_HOME/manifest.awk" "$PROJ/$MANIFEST" || die "не удалось разобрать манифест"
		echo "$RT: $IPAB_HOME/runtime/availability.c"
		printf '\t@mkdir -p %s\n' "$CACHE/rt"
		printf '\t@clang -target arm64-apple-ios12.0 -isysroot %s -O2 -c $< -o $@\n' "$SDK"
	} > "$MK.tmp"
	cmp -s "$MK.tmp" "$MK" && rm "$MK.tmp" || mv "$MK.tmp" "$MK"
}

# ---------------------------------------------------------------- resources (MANIFEST mode)
# RESOURCES=resources.tsv:  "bundle <name> <Info.plist fragment base64>" / "file <bundle or empty> <path>".
# - asset catalogs (.xcassets) can't be compiled without actool: every imageset is rasterized
#   (PDF via pdftocairo, SVG via rsvg-convert, PNG/JPG copied) to <bundle>/ModAssets/<name>@2x/@3x.png,
#   template images listed in ModAssets/templates.txt — the app loads them when Assets.car is absent;
# - .metal sources of a bundle are joined into <bundle>/default.metal (compiled on the device);
# - files under *.lproj keep that folder, everything else goes to the bundle root.
resource_job() {  # kind src dst scale — one rasterization, skipped when dst is newer than src
	local kind=$1 src=$2 dst=$3 scale=$4
	[ -f "$dst" ] && [ "$dst" -nt "$src" ] && return 0
	mkdir -p "$(dirname "$dst")"
	case $kind in
	pdf) pdftocairo -png -singlefile -transp -r $((72 * scale)) "$src" "${dst%.png}" ;;
	svg) rsvg-convert -z "$scale" -o "$dst" "$src" ;;
	*) cp -f "$src" "$dst" ;;
	esac
}
export -f resource_job

process_resources() {
	local SRC=$1 EXT=$2 GEN=$3 APP=$4
	local file=$PROJ/$RESOURCES
	[ -f "$file" ] || die "нет $file"
	say "ресурсы ($RESOURCES)"
	local jobs=$B/resource-jobs.txt kind bundle path dir dst rel
	: > "$jobs"
	local -A imagesets=() metal=()
	while IFS=$'\t' read -r kind bundle path; do
		dir=$APP; [ -n "$bundle" ] && dir=$APP/$bundle.bundle
		mkdir -p "$dir"
		if [ "$kind" = bundle ]; then
			{
				echo '<?xml version="1.0" encoding="UTF-8"?>'
				echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
				echo '<plist version="1.0"><dict>'
				printf '%s' "$path" | base64 -d
				echo '<key>CFBundlePackageType</key><string>BNDL</string>'
				echo '</dict></plist>'
			} > "$dir/Info.plist.tmp"
			cmp -s "$dir/Info.plist.tmp" "$dir/Info.plist" && rm "$dir/Info.plist.tmp" || mv "$dir/Info.plist.tmp" "$dir/Info.plist"
			continue
		fi
		path=${path//@@SRC@@/$SRC}; path=${path//@@EXT@@/$EXT}; path=${path//@@GEN@@/$GEN}
		case $path in
		*.xcassets/*.imageset/*) imagesets["$dir|${path%/*}"]=1; continue ;;
		*.xcassets/*) continue ;;
		*.metal) metal[$dir]+="$path"$'\n'; continue ;;
		*.storyboard|*.xib|*.intentdefinition) continue ;;
		esac
		[ -f "$path" ] || continue
		case $path in
		*.lproj/*) rel=${path%/*}; dst=$dir/${rel##*/}/${path##*/} ;;
		*) dst=$dir/${path##*/} ;;
		esac
		if [ ! -f "$dst" ] || [ "$path" -nt "$dst" ]; then mkdir -p "$(dirname "$dst")"; cp -f "$path" "$dst"; fi
	done < "$file"

	# imagesets -> rasterization jobs
	local key set catalog name part sub ns templates
	local -A tmpl=()
	for key in "${!imagesets[@]}"; do
		dir=${key%%|*}; set=${key#*|}
		catalog=${set%%.xcassets/*}.xcassets
		rel=${set#"$catalog"/}
		name=""; sub=$catalog
		local -a parts=()
		IFS=/ read -ra parts <<< "$rel"
		for part in "${parts[@]}"; do
			sub=$sub/$part
			case $part in
			*.imageset) name+=${part%.imageset} ;;
			*) ns=$(jq -r '.properties."provides-namespace" // false' "$sub/Contents.json" 2>/dev/null || echo false)
			   [ "$ns" = true ] && name+=$part/ ;;
			esac
		done
		[ -f "$set/Contents.json" ] || continue
		if [ "$(jq -r '.properties."template-rendering-intent" // ""' "$set/Contents.json")" = template ]; then
			tmpl[$dir]+="$name"$'\n'
		fi
		local fname scale ext
		while IFS=$'\t' read -r fname scale; do
			[ -n "$fname" ] && [ -f "$set/$fname" ] || continue
			ext=${fname##*.}; ext=${ext,,}
			case $ext in
			pdf|svg)
				if [ -z "$scale" ]; then
					printf '%s\t%s\t%s\t%s\n' "$ext" "$set/$fname" "$dir/ModAssets/$name@2x.png" 2 >> "$jobs"
					printf '%s\t%s\t%s\t%s\n' "$ext" "$set/$fname" "$dir/ModAssets/$name@3x.png" 3 >> "$jobs"
				else
					printf '%s\t%s\t%s\t%s\n' "$ext" "$set/$fname" "$dir/ModAssets/$name@${scale}.png" "${scale%x}" >> "$jobs"
				fi ;;
			png|jpg|jpeg)
				local sfx=""; [ -n "$scale" ] && [ "$scale" != 1x ] && sfx=@$scale
				printf '%s\t%s\t%s\t%s\n' copy "$set/$fname" "$dir/ModAssets/$name$sfx.png" 1 >> "$jobs" ;;
			esac
		done < <(jq -r '.images[]? | select(.filename) | [.filename, (.scale // "")] | @tsv' "$set/Contents.json")
	done
	for dir in "${!tmpl[@]}"; do
		mkdir -p "$dir/ModAssets"
		printf '%s' "${tmpl[$dir]}" | sort > "$dir/ModAssets/templates.txt.tmp"
		cmp -s "$dir/ModAssets/templates.txt.tmp" "$dir/ModAssets/templates.txt" && rm "$dir/ModAssets/templates.txt.tmp" || mv "$dir/ModAssets/templates.txt.tmp" "$dir/ModAssets/templates.txt"
	done
	say "картинки: $(wc -l < "$jobs") файлов из ${#imagesets[@]} наборов"
	tr '\t' '\0' < "$jobs" | xargs -0 -n4 -P"$JOBS" bash -c 'resource_job "$@"' _ || die "не удалось подготовить картинки"

	# shaders: one source per bundle, local #include "…" inlined
	local m
	for dir in "${!metal[@]}"; do
		{
			while IFS= read -r m; do
				[ -n "$m" ] || continue
				echo "// ---- ${m##*/}"
				awk -v base="${m%/*}" '
					function emit(f,   line, inc) {
						while ((getline line < f) > 0) {
							if (match(line, /^[ \t]*#[ \t]*include[ \t]*"[^"]+"/)) {
								inc = line; sub(/^[^"]*"/, "", inc); sub(/".*$/, "", inc)
								if (!((base "/" inc) in seen)) { seen[base "/" inc] = 1; emit(base "/" inc) }
							} else if (line ~ /^[ \t]*#[ \t]*pragma[ \t]+once/) {
							} else print line
						}
						close(f)
					}
					BEGIN { emit(ARGV[1]); exit }' "$m"
			done <<< "${metal[$dir]}"
		} > "$dir/default.metal.tmp"
		cmp -s "$dir/default.metal.tmp" "$dir/default.metal" && rm "$dir/default.metal.tmp" || mv "$dir/default.metal.tmp" "$dir/default.metal"
	done
}

# ---------------------------------------------------------------- MANIFEST mode
# Big multi-module projects (e.g. a Telegram fork): libraries are described by a TSV manifest
# (format in manifest.awk) instead of src/. Called from cmd_build with its locals (B OBJ mode release).
#   MANIFEST=manifest.tsv            path relative to the project
#   ROOTS="//app:Main //app:Lib"     labels to link into the app; everything they depend on is built
#   SRCROOT=..                       where manifest paths start (default: the project dir)
#   EXTDIR=external                  @ext/<repo>/… files (default: <project>/external)
#   PREBUILD=prebuild.sh             run before make with GEN SRCROOT SDK MIN_IOS JOBS CACHE in env;
#                                    produces @gen/… files (generated sources, third-party static libs)
#   SWIFT_THREADS=4                  swiftc -num-threads per module
build_manifest() {
	local SRC; SRC=$(cd "$PROJ/${SRCROOT:-.}" && pwd)
	local EXT; EXT=$(cd "$PROJ" && readlink -f "${EXTDIR:-external}")
	local GEN=$B/gen
	[ -f "$PROJ/$MANIFEST" ] || die "нет манифеста $PROJ/$MANIFEST"
	[ -n "$ROOTS" ] || die "ROOTS пустой в ipa.conf"
	[ -x "$SWIFTC" ] || die "нет тулчейна Swift в $TC/swift"
	mkdir -p "$GEN" "$OBJ"

	# Apple tools (xcrun, libtool, lipo, arm-apple-darwin-*) for third-party build scripts
	local XPATH="$IPAB_HOME/shims/bin:$PATH"
	# Fake Xcode developer dir: scripts look for …/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS*.sdk
	# and …/Toolchains/XcodeDefault.xctoolchain/usr/bin/<tool>.
	local DEV=$CACHE/xcode/$(basename "$SDK" .sdk)/Xcode.app/Contents/Developer x
	if [ ! -d "$DEV" ]; then
		mkdir -p "$DEV/Platforms/iPhoneOS.platform/Developer/SDKs" "$DEV/Toolchains/XcodeDefault.xctoolchain/usr/bin" "$DEV/usr/bin"
		ln -sfn "$SDK" "$DEV/Platforms/iPhoneOS.platform/Developer/SDKs/$(basename "$SDK")"
		ln -sfn "$SDK" "$DEV/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk"
		for x in "$IPAB_HOME"/shims/xcrun-tools/*; do
			ln -sfn "$x" "$DEV/Toolchains/XcodeDefault.xctoolchain/usr/bin/$(basename "$x")"
		done
		for x in clang clang++; do ln -sfn "$IPAB_HOME/shims/xcrun-tools/ios-cc" "$DEV/Toolchains/XcodeDefault.xctoolchain/usr/bin/$x"; done
		ln -sfn "$IPAB_HOME/shims/bin/xcrun" "$DEV/usr/bin/xcrun"
	fi
	export IPAB_DEVELOPER_DIR=$DEV

	local OPTC="-O0 -g0" OPTS="-Onone"
	[ $release = 1 ] && { OPTC="-Os -g0"; OPTS="-O"; }
	mstamp() { printf '%s\n' "$2" > "$OBJ/$1.tmp"; cmp -s "$OBJ/$1.tmp" "$OBJ/$1" && rm "$OBJ/$1.tmp" || mv "$OBJ/$1.tmp" "$OBJ/$1"; }
	mstamp cflags.stamp "$SDK $MIN_IOS $OPTC $CFLAGS"
	mstamp swflags.stamp "$SDK $MIN_IOS $OPTS $SWIFT_THREADS $SWIFTFLAGS"
	mstamp ldflags.stamp "$SDK $MIN_IOS $LDFLAGS $ENTITLEMENTS"

	local MK=$B/Makefile.$mode
	write_manifest_makefile "$SRC" "$EXT" "$GEN" "$MK"
	[ -n "$GENRULES" ] && run_genrules "$SRC" "$EXT" "$GEN" "$XPATH" "$MK"
	if [ -n "$PREBUILD" ]; then
		say "подготовка ($PREBUILD)"
		PATH=$XPATH IPAB_SDK=$SDK IPAB_MIN_IOS=$MIN_IOS GEN=$GEN SRCROOT=$SRC SDK=$SDK MIN_IOS=$MIN_IOS JOBS=$JOBS CACHE=$CACHE IPAB_HOME=$IPAB_HOME \
			bash "$PROJ/$PREBUILD" || die "PREBUILD не удался"
	fi


	say "сборка $NAME ($mode, $JOBS потоков, $(grep -c '' "$PROJ/$MANIFEST") библиотек в манифесте)"
	make -s -C "$SRC" -f "$MK" -j"$JOBS" ${IPAB_KEEP_GOING:+-k} || die "компиляция не удалась"
}

cmd_clean() { local p=${1:-.}; rm -rf "$p/build"; say "очищено $p/build"; }

case ${1:-} in
new) shift; cmd_new "$@" ;;
build|b) shift; cmd_build "$@" ;;
clean) shift; cmd_clean "$@" ;;
*) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
